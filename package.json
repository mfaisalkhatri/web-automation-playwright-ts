{
  "name": "web-automation-playwright-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test-demo-env": "npx playwright test --project=demo",
    "test-chatapp": "npx playwright test /tests/chat-app.spec.ts --project=chrome",
    "test-parabank": "npx playwright test /tests/parabank.test.ts --project=chrome --headed",
    "test-parabank-registration": "npx playwright test /tests/parabank.registration.spec.ts --project=chrome --headed",
    "test-report-junit": "npx playwright test tests/parabank.test.ts --project=qa --reporter=junit",
    "test-report-blob": "npx playwright test tests/parabank.test.ts --project=qa --reporter=blob",
    "test-report-dot": "npx playwright test tests/parabank.test.ts --project=qa --reporter=dot",
    "test-report-line": "npx playwright test tests/parabank.test.ts --project=qa --reporter=line",
    "test-report-list": "npx playwright test tests/parabank.test.ts --project=qa --reporter=list",
    "test-report-json": "npx playwright test tests/parabank.test.ts --project=qa --reporter=json",
    "test-data-driven-json": "npx playwright test /tests/data-driven-test.spec.ts --project=chrome --headed",
    "test-shard-1/4": "npx playwright test tests/parallel_test_examples --shard=1/4",
    "test-shard-1/2": "npx playwright test tests/parallel_test_examples --shard=1/2",
    "test-list": "npx playwright test tests/parallel_test_examples --list",
    "test:parabank-e2e": "npx playwright test tests/parabank_e2e/parabank.test.ts --project=qa"

  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
